# ===== 岗位能力图谱系统 环境变量模板 =====
# 复制为 .env 并填入真实值（可选；默认全 mock 即可跑通）

# LLM 抽取提供商：mock（默认，规则化抽取，无需 API）| spark（讯飞星火）
JOB_GRAPH_LLM_PROVIDER=mock

# 讯飞星火（仅当 provider=spark 时需要）
SPARK_API_KEY=
SPARK_API_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
SPARK_MODEL=spark-lite

# 自定义配置覆盖文件（JSON，与 config/default.json 深合并）
# JOB_GRAPH_CONFIG=/path/to/override.json
